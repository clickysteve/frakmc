{
  "name": "frakmc",
  "version": "0.1.0",
  "private": true,
  "description": "FrakMC — an independent browser-based fractal music composer inspired by and informed by Hugh McDowell's Fractal Music Composer 2 (Atari ST)",
  "homepage": "https://frakmc.allmyfriendsaresynths.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/clickysteve/frakmc.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:pages": "tsc --noEmit && vite build --base=/",
    "e2e": "node e2e/e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "marked": "^18.1.0",
    "puppeteer-core": "^25.12.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@fontsource/vt323": "^5.3.0"
  }
}
